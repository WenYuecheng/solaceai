AGENT_FRAMEWORK=langgraph
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=solaceai-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=solaceai-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/solaceai-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=solaceai-qwen2.5-7b-ft-q4_k_m.gguf
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
EMBEDDING_BASE_URL=https://api.chatanywhere.tech/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
DATABASE_URL=mysql+pymysql://solaceai:solaceai@127.0.0.1:3306/solaceai?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
REDIS_HISTORY_CACHE_ENABLED=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=solaceai_te3small_1024
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
EMBEDDING_TIMEOUT_SECONDS=30
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
# QQ 邮箱：开启 SMTP，使用独立授权码（不是 QQ 登录密码）；以下为 SSL 465 示例
# 验证码和预警共用本 SMTP 服务；log 模式不发邮件，验证码接口会明确提示未发送
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[SolaceAI 高风险预警]

# Upgrade features remain opt-in until independently evaluated
PAID_API_ENABLED=false
API_BUDGET_CNY=null
API_PRICE_CHAT_INPUT_CNY_PER_MILLION=0
API_PRICE_CHAT_OUTPUT_CNY_PER_MILLION=0
API_PRICE_EMBEDDING_CNY_PER_MILLION=0.14
API_PRICE_RERANK_CNY_PER_MILLION=0
KNOWLEDGE_RETRIEVAL_MODE=upgraded
KNOWLEDGE_REWRITE_ENABLED=false
KNOWLEDGE_CONTEXTUAL_ENABLED=false
RERANKER_ENABLED=false
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
AGENT_CHECKPOINT_PATH=data/agent-checkpoints.sqlite
AGENT_MEMORY_PATH=data/agent-memory.sqlite

OPENAI_THINKING_ENABLED=false

EMOTION_CLASSIFIER_ENABLED=true
# auto: enabled local classifier drives risk; disabled uses cloud assessment.
# local: local rules on classifier failure, never cloud risk fallback; cloud: cloud assessment.
RISK_ASSESSMENT_SOURCE=auto
EMOTION_CLASSIFIER_TIMEOUT_SECONDS=20

# 本机BGE/Milvus可选链路；普通Chroma路径仍可使用。
KNOWLEDGE_BACKEND=chroma_bm25
KNOWLEDGE_PARENT_CHUNK_SIZE=1200
LOCAL_RAG_URL=http://127.0.0.1:8091
LOCAL_RAG_TIMEOUT_SECONDS=180
LOCAL_RAG_AUTOSTART=false
LOCAL_RAG_PYTHON=
LOCAL_BGE_MODEL_PATH=models/bge-m3
LOCAL_RERANKER_MODEL_PATH=models/bge-reranker-large
LOCAL_RAG_DEVICE=cpu
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=solaceai_bge
RERANKER_PROVIDER=api

OPENAI_REASONING_EFFORT=

# 高德官方 MCP：仅 Web 服务 Key，生产禁用模拟医院结果
AMAP_ENABLED=false
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=8
AMAP_DAILY_CALL_LIMIT=100
AMAP_CACHE_TTL_SECONDS=900
AMAP_USAGE_PATH=data/amap-usage.sqlite
