# Configure the Java parity profile. Do not commit a populated copy.
SPRING_PROFILES_ACTIVE=parity
SERVER_PORT=8080
MINDBRIDGE_BOOTSTRAP_ADMIN_PASSWORD=
MINDBRIDGE_BOOTSTRAP_BUNDLED_KNOWLEDGE=false
MODEL_BACKEND=local
LOCAL_FALLBACK_ENABLED=false
AI_PROVIDER=ollama
LOCAL_GATEWAY_URL=http://127.0.0.1:18181
LOCAL_GATEWAY_TOKEN=
KNOWLEDGE_BACKEND=bm25
BGE_WORKER_URL=http://127.0.0.1:8091
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=mindbridge_knowledge
BGE_RERANKER_ENABLED=false
# The shared gateway serves solace-emotion and solace-response.
# For Milvus and BGE-M3: KNOWLEDGE_BACKEND=milvus_bge; optional BGE_RERANKER_ENABLED=true.
