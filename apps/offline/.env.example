# Shared model credentials and connections are read from the root .env.
# Only profile-specific values belong here. OS environment still takes precedence.
SERVER_HOST=127.0.0.1
SERVER_PORT=8082
KNOWLEDGE_BACKEND=milvus_bge
RISK_ASSESSMENT_SOURCE=local
EMOTION_CLASSIFIER_ENABLED=true
LOCAL_RAG_AUTOSTART=true
RERANKER_PROVIDER=local_cross_encoder
# LOCAL_RAG_PYTHON=.venv-rag/bin/python
# MySQL DATABASE_URL is inherited from the root .env.

# PDF/Office/OCR uses the isolated ML environment to avoid API dependency conflicts.
DOCUMENT_CONVERTER_PYTHON=.venv-rag/bin/python
# Enable after caching Docling layout and table models on the demo machine.
# DOCLING_MODELS_OFFLINE=true
