# Shared model credentials and connections are read from the root .env.
# Only profile-specific values belong here. OS environment still takes precedence.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_URL=sqlite:///data/online/solaceai.sqlite
KNOWLEDGE_BACKEND=chroma_bm25
RISK_ASSESSMENT_SOURCE=cloud
EMOTION_CLASSIFIER_ENABLED=false
LOCAL_RAG_AUTOSTART=false
RERANKER_PROVIDER=lexical
EMBEDDING_TIMEOUT_SECONDS=8

# Persistent shared daily cap; reset at midnight Asia/Shanghai. Do not delete its ledger.
API_DAILY_BUDGET_CNY=1
